{
  "name": "boxi-yu-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && astro dev --host 127.0.0.1",
    "dev:drafts": "CONTENT_PREVIEW=true npm run dev",
    "check": "astro check",
    "build": "npm run prepare:assets && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "astro": "7.3.2",
    "bibtex-parse-js": "0.0.23",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.5.0",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  }
}
