---
import { featuredCourses } from '../data/courses';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const steps = [
  ['Step through', 'Watch the code or the agent loop run, one state at a time.'],
  ['Predict', 'Commit to an answer before the page shows you the real output.'],
  ['Check', 'End every lecture with a self-check and exercises.'],
];
---

<div class="course-showcase">
  <ol class="course-steps" aria-label="How each lecture works">
    {
      steps.map(([title, copy], index) => (
        <li>
          <span class="course-step-index">{index + 1}</span>
          <div>
            <strong>{title}</strong>
            <span>{copy}</span>
          </div>
        </li>
      ))
    }
  </ol>
  <div class="course-cards">
    {
      featuredCourses.map((course) => (
        <article class="course-card" id={course.id} aria-labelledby={`${course.id}-title`}>
          <header class="course-card-band">
            <div class="course-card-meta">
              <span>{course.level}</span>
              <span>{course.lectures.length} lectures</span>
            </div>
            <p class="course-card-code" aria-hidden="true">
              {course.code}
            </p>
          </header>
          <div class="course-card-body">
            <Heading id={`${course.id}-title`}>
              <span class="visually-hidden">{course.code}: </span>
              {course.name}
            </Heading>
            <p class="course-card-who">
              {course.term} · Instructor:{' '}
              {course.instructorHref ? (
                <a href={course.instructorHref}>{course.instructor}</a>
              ) : (
                course.instructor
              )}
              {course.official && (
                <>
                  {' · '}
                  <a href={course.official}>Official course site</a>
                </>
              )}
            </p>
            <p class="course-card-summary">{course.summary}</p>
            <ol class="course-card-lectures" start={course.firstLecture}>
              {course.lectures.map((lecture, index) => (
                <li>
                  <a href={`${course.href}L${String(course.firstLecture + index).padStart(2, '0')}/`}>
                    <span class="course-card-lecture-number">
                      {String(course.firstLecture + index).padStart(2, '0')}
                    </span>
                    {lecture}
                  </a>
                </li>
              ))}
            </ol>
            <div class="course-card-footer">
              <span>{course.detail}</span>
              <a class="course-card-cta" href={course.href}>
                Open the notes <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
  <p class="course-credit">
    I co-designed these notes and videos, built with 培玉智能. Slides and course content belong to each instructor.
  </p>
</div>

<style>
  .course-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }
  .course-steps li {
    display: flex;
    gap: 14px;
    align-items: start;
    padding: 16px 0 0;
    border-top: 2px solid var(--blueberry);
  }
  .course-step-index {
    flex-shrink: 0;
    color: var(--strawberry);
    font-family: var(--serif);
    font-size: 28px;
    line-height: 1;
  }
  .course-steps strong {
    display: block;
    color: var(--ink);
    font-size: 16px;
  }
  .course-steps li span:not(.course-step-index) {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .course-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .course-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
    scroll-margin-top: 96px;
  }
  .course-card-band {
    padding: 22px 26px 18px;
    color: var(--buttercream);
    background: linear-gradient(135deg, var(--blueberry), var(--blue-dark) 85%);
  }
  .course-card:nth-child(2) .course-card-band {
    background: linear-gradient(135deg, var(--strawberry-dark), #5d1612 85%);
  }
  .course-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .course-card-code {
    margin-top: 26px;
    color: white;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: clamp(2.6rem, 5.4vw, 4.2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .course-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px 26px 26px;
  }
  .course-card-body :is(h2, h3) {
    color: var(--blueberry);
    font-family: var(--serif);
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    font-weight: 400;
    line-height: 1.1;
  }
  .course-card-who {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
  }
  .course-card-summary {
    margin-top: 16px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }
  .course-card-lectures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 20px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .course-card-lectures li {
    border-bottom: 1px solid var(--line);
  }
  .course-card-lectures a {
    display: flex;
    gap: 10px;
    padding: 8px 0;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.35;
    text-decoration: none;
  }
  .course-card-lectures a:hover {
    color: var(--strawberry);
  }
  .course-card-lecture-number {
    flex-shrink: 0;
    color: var(--muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    line-height: 1.6;
  }
  .course-card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding-top: 24px;
    color: var(--muted);
    font-size: 13px;
  }
  .course-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 9px 17px;
    border-radius: 999px;
    color: white;
    background: var(--strawberry);
    font-size: 15px;
    text-decoration: none;
  }
  .course-card-cta:hover {
    color: white;
    background: var(--strawberry-dark);
    text-decoration: none;
  }
  .course-credit {
    margin-top: 16px;
    color: var(--muted);
    font-size: 13px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .course-cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 680px) {
    .course-steps {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .course-card-band,
    .course-card-body {
      padding-inline: 20px;
    }
    .course-card-lectures {
      grid-template-columns: 1fr;
    }
  }
</style>
