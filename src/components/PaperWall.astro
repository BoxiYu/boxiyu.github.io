---
/**
 * A slowly drifting wall of first pages, after the hero on frontier-cs.org.
 * Thumbnails live in assets/img/papers/<citation key>.webp; papers without
 * one are left out. The wall is decorative (each paper is listed on
 * /publications/), so it is hidden from assistive tech and keyboard focus;
 * the caption carries the one real link.
 *
 * With `background`, only the drifting stage is rendered, absolutely
 * positioned behind its parent's content under a paper-coloured veil.
 */
import { existsSync } from 'node:fs';
import { publications } from '../lib/publications';
import { researchGroups, empiricalResearch } from '../data/research';
import { projects } from '../data/site';

interface Props {
  background?: boolean;
}
const { background = false } = Astro.props;

// Which research theme each paper belongs to, from the homepage research map,
// so hovering a theme can light up its papers on the wall.
const themeOf: Record<string, string> = {};
for (const group of [...researchGroups, empiricalResearch]) {
  for (const id of group.projects) {
    const key = projects.find((project) => project.id === id)?.paper;
    if (key) themeOf[key] = group.id;
  }
  for (const item of group.related) themeOf[item.href.split('#')[1]] = group.id;
}

const papers = publications
  .filter((p) => existsSync(`assets/img/papers/${p.id}.webp`))
  .map((p) => ({
    id: p.id,
    label: `${p.venue === 'arXiv' ? 'arXiv' : p.venue} ${p.year}`,
    theme: themeOf[p.id] ?? '',
  }));

const columnCount = 10;
const perColumn = 5;
// Too few thumbnails (e.g. a test build without assets) would repeat badly; skip the wall.
const columns =
  papers.length < perColumn
    ? []
    : Array.from({ length: columnCount }, (_, c) =>
        Array.from({ length: perColumn }, (_, i) => papers[(c * 3 + i * 2) % papers.length]),
      );
const durations = [74, 92, 68, 86, 78, 96, 70, 88, 72, 84];
---

{
  columns.length > 0 &&
    (background ? (
      <div class="paper-wall-bg" aria-hidden="true">
        <div class="paper-wall-stage">
          <div class="paper-wall-plane">
            {columns.map((column, c) => (
              <div
                class:list={['paper-wall-column', { 'paper-wall-column-down': c % 2 === 1 }]}
                style={`--drift: ${durations[c]}s`}
              >
                {[...column, ...column, ...column].map((paper) => (
                  <span class="paper-wall-card" data-theme={paper.theme || undefined}>
                    <img
                      src={`/assets/img/papers/${paper.id}.webp`}
                      width="360"
                      height="466"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{paper.label}</span>
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <section class="paper-wall" aria-labelledby="paper-wall-caption">
        <div class="paper-wall-stage" aria-hidden="true">
          <div class="paper-wall-plane">
            {columns.map((column, c) => (
              <div
                class:list={['paper-wall-column', { 'paper-wall-column-down': c % 2 === 1 }]}
                style={`--drift: ${durations[c]}s`}
              >
                {[...column, ...column].map((paper) => (
                  <a class="paper-wall-card" href={`/publications/#${paper.id}`} tabindex="-1">
                    <img
                      src={`/assets/img/papers/${paper.id}.webp`}
                      width="360"
                      height="466"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{paper.label}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
        <p class="paper-wall-caption" id="paper-wall-caption">
          <span>{publications.length} papers</span>
          <span class="paper-wall-topic">
            on testing and evaluating AI systems and coding agents.
          </span>
          <a href="/publications/">
            All publications <span aria-hidden="true">↗</span>
          </a>
        </p>
      </section>
    ))
}

<style>
  .paper-wall {
    position: relative;
    overflow: hidden;
    height: 360px;
    border-block: 1px solid var(--line);
    background: linear-gradient(180deg, var(--wash), var(--paper));
  }
  .paper-wall-stage {
    position: absolute;
    inset: 0;
    perspective: 1600px;
    mask-image:
      linear-gradient(to right, transparent, black 12%, black 88%, transparent),
      linear-gradient(to bottom, transparent, black 18%, black 80%, transparent);
    mask-composite: intersect;
  }
  .paper-wall-plane {
    position: absolute;
    top: -40%;
    left: 50%;
    display: flex;
    gap: 22px;
    transform: translateX(-50%) rotateX(24deg) rotateZ(-10deg);
    transform-style: preserve-3d;
  }
  .paper-wall-column {
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: paper-drift var(--drift, 80s) linear infinite;
    will-change: transform;
  }
  .paper-wall-column-down {
    animation-direction: reverse;
  }
  .paper-wall:hover .paper-wall-column {
    animation-play-state: paused;
  }
  @keyframes paper-drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-50% - 11px));
    }
  }
  .paper-wall-card {
    position: relative;
    display: block;
    width: 168px;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background: white;
    box-shadow: 0 10px 24px -18px rgba(var(--blueberry-rgb), 0.6);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .paper-wall-card:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 18px 32px -18px rgba(var(--blueberry-rgb), 0.75);
  }
  .paper-wall-card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .paper-wall-card span {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    color: white;
    background: var(--blueberry);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .paper-wall-caption {
    position: absolute;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    max-width: calc(100% - 32px);
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: color-mix(in srgb, var(--paper-raised) 92%, transparent);
    backdrop-filter: blur(6px);
    font-size: 15px;
    text-align: center;
    box-shadow: 0 10px 30px -20px rgba(var(--blueberry-rgb), 0.6);
  }
  .paper-wall-caption > span:first-child {
    color: var(--ink);
    font-weight: 600;
  }
  .paper-wall-caption a {
    margin-left: 6px;
    white-space: nowrap;
  }
  @media (max-width: 680px) {
    .paper-wall {
      height: 260px;
    }
    .paper-wall-plane,
    .paper-wall-column {
      gap: 14px;
    }
    .paper-wall-card {
      width: 120px;
    }
    .paper-wall-caption {
      bottom: 14px;
      font-size: 14px;
      white-space: nowrap;
    }
    .paper-wall-topic {
      display: none;
    }
  }
  /* Background mode: the wall fills its positioned parent, under a veil. */
  .paper-wall-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .paper-wall-bg .paper-wall-stage {
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 85%, transparent);
  }
  .paper-wall-bg .paper-wall-plane {
    top: -30%;
  }
  .paper-wall-bg .paper-wall-card {
    width: 190px;
    box-shadow: none;
  }
  .paper-wall-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    transition: opacity 0.35s ease;
    background:
      radial-gradient(
        ellipse at 50% 45%,
        color-mix(in srgb, var(--paper) 78%, transparent),
        transparent 75%
      ),
      color-mix(in srgb, var(--paper) 58%, transparent);
  }
  @media (max-width: 860px) {
    .paper-wall-bg {
      position: relative;
      inset: auto;
      height: 200px;
      margin-bottom: -40px;
    }
    .paper-wall-bg .paper-wall-card {
      width: 120px;
    }
  }
  /* Hovering a theme on the research map lights up its papers. */
  .paper-wall-bg .paper-wall-card {
    transition:
      opacity 0.35s ease,
      filter 0.35s ease,
      outline-color 0.35s ease,
      box-shadow 0.35s ease;
    outline: 4px solid transparent;
    outline-offset: 0;
  }
  :global(.research-stage[data-focus]) .paper-wall-bg::after {
    opacity: 0.12;
  }
  :global(.research-stage[data-focus]) .paper-wall-bg .paper-wall-card {
    opacity: 0.1;
    filter: grayscale(1);
  }
  :global(.research-stage[data-focus='coding-agents'])
    .paper-wall-bg
    .paper-wall-card[data-theme='coding-agents'],
  :global(.research-stage[data-focus='test-oracles'])
    .paper-wall-bg
    .paper-wall-card[data-theme='test-oracles'],
  :global(.research-stage[data-focus='ai-systems'])
    .paper-wall-bg
    .paper-wall-card[data-theme='ai-systems'],
  :global(.research-stage[data-focus='aiops']) .paper-wall-bg .paper-wall-card[data-theme='aiops'] {
    opacity: 1;
    filter: none;
    outline-color: var(--focus-tone);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--focus-tone) 22%, transparent);
  }
  :global(.research-stage[data-focus='coding-agents']) {
    --focus-tone: var(--blueberry);
  }
  :global(.research-stage[data-focus='test-oracles']) {
    --focus-tone: var(--strawberry);
  }
  :global(.research-stage[data-focus='ai-systems']) {
    --focus-tone: #2f7a56;
  }
  :global(.research-stage[data-focus='aiops']) {
    --focus-tone: #0f6e73;
  }
  @media (prefers-reduced-motion: reduce) {
    .paper-wall-column {
      animation: none;
    }
  }
</style>
