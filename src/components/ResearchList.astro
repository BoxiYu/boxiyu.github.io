---
import { paperVideos, projects } from '../data/site';
import { publications } from '../lib/publications';
interface Props {
  selected?: string[];
}
const { selected = ['swe-abs', 'utboost', 'retromorphic-testing', 'lightad'] } = Astro.props;
---

<div class="research-list">
  {
    projects
      .filter((project) => selected.includes(project.id))
      .map((project) => {
        const paper = publications.find((paper) => paper.id === project.paper)!;
        const video = paperVideos[project.id];
        return (
          <article
            class:list={['research-item', 'selected-paper', { 'selected-paper-clip': video }]}
            id={project.id}
          >
            {video ? (
              <a
                class="selected-clip"
                href={`/research/#${project.id}`}
                aria-label={`Watch the ${video.duration} ${project.name} explainer`}
              >
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={`/assets/video/clips/${project.id}-poster.jpg`}
                  data-autoplay
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <source src={`/assets/video/clips/${project.id}.mp4`} type="video/mp4" />
                </video>
                <span class="selected-clip-chip" aria-hidden="true">
                  ▶ {video.duration} explainer
                </span>
              </a>
            ) : null}
            <div class="venue">
              <b>
                {project.venue} {project.year}
              </b>
              {project.name}
              {project.venue === 'arXiv' && <span class="preprint-note">Preprint</span>}
            </div>
            <div class="selected-body">
              <h4>
                <a href={`/publications/#${project.paper}`}>{paper.title}</a>
              </h4>
              <p class="selected-authors">
                {paper.authors.map((author, i) => (
                  <>
                    {i > 0 && ', '}
                    {author === 'Boxi Yu' ? <strong>{author}</strong> : author}
                  </>
                ))}
              </p>
              <p>{project.summary}</p>
              <div class="resource-links">
                {project.links.slice(0, 2).map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
                <a href={`/research/#${project.id}`}>Research summary</a>
                <a href={`/publications/#${project.paper}`}>Citation</a>
              </div>
            </div>
          </article>
        );
      })
  }
</div>
