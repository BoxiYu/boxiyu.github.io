---
/**
 * The homepage research map: one question, three themes, and the works in
 * each. Cards are translucent so the paper wall behind them shows through.
 * Venue pills are solid for peer-reviewed work and outlined for preprints;
 * first-authored works are set in bold.
 */
import { researchGroups, empiricalResearch } from '../data/research';
import { projects } from '../data/site';
import { publications } from '../lib/publications';

const tones: Record<string, string> = {
  'coding-agents': 'blueberry',
  'test-oracles': 'strawberry',
  'ai-systems': 'moss',
};
const firstAuthored = (key?: string) =>
  publications.find((paper) => paper.id === key)?.authors[0] === 'Boxi Yu';

const groups = researchGroups.map((group) => {
  const works = [
    ...group.projects.map((id) => {
      const project = projects.find((project) => project.id === id)!;
      return {
        name: project.name,
        href: `/research/#${id}`,
        venue: `${project.venue} ${project.year}`,
        peer: project.venue !== 'arXiv',
        first: firstAuthored(project.paper),
      };
    }),
    ...group.related.map((item) => ({
      name: item.name,
      href: item.href,
      venue: item.venue.replace(' · Preprint', ''),
      peer: !item.venue.startsWith('arXiv'),
      first: firstAuthored(item.href.split('#')[1]),
    })),
  ];
  return { ...group, tone: tones[group.id] ?? 'blueberry', works };
});
---

<figure class="research-map" aria-labelledby="map-question" aria-describedby="map-caption">
  <div class="map-question" id="map-question">
    <span class="map-kicker">The question</span>
    How do we establish that software and AI behave correctly?
  </div>
  <div class="map-branches">
    {
      groups.map((group) => (
        <section
          class:list={['map-branch', `map-branch-${group.tone}`]}
          aria-labelledby={`map-${group.id}`}
        >
          <div class="map-branch-top">
            <span class="map-icon" aria-hidden="true">
              {group.id === 'coding-agents' && (
                <svg viewBox="0 0 24 24">
                  <path d="M8 7 3 12l5 5M16 7l5 5-5 5M13.5 5l-3 14" />
                </svg>
              )}
              {group.id === 'test-oracles' && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 9h13l-3-3M20 15H7l3 3" />
                </svg>
              )}
              {group.id === 'ai-systems' && (
                <svg viewBox="0 0 24 24">
                  <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              )}
            </span>
            <span class="map-count">{group.works.length} works</span>
          </div>
          <h3 id={`map-${group.id}`}>
            <a href={`/research/#${group.id}`}>{group.title}</a>
          </h3>
          <p>{group.description}</p>
          <ul>
            {group.works.map((work) => (
              <li>
                <a href={work.href}>
                  <span class:list={['map-work', { 'map-work-first': work.first }]}>
                    {work.name}
                  </span>
                  <span class:list={['map-venue', work.peer ? 'map-venue-peer' : 'map-venue-pre']}>
                    {work.venue}
                    {!work.peer && <span class="visually-hidden"> preprint</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <div class="map-empirical">
    <a class="map-empirical-title" href={`/research/#${empiricalResearch.id}`}
      >{empiricalResearch.title}</a
    >
    <p>
      <a href="/research/#lightad"><strong>LightAD</strong></a>, <a
        href="/publications/#fang2026openrca">OpenRCA 2.0</a
      >, and <a href="/publications/#zhang2025cleanet">CLEANet</a> examine model efficiency, causal diagnosis,
      and robustness to contaminated data.
    </p>
  </div>
  <figcaption id="map-caption">
    <span class="map-legend"
      ><span class="map-venue map-venue-peer">Peer-reviewed</span><span
        class="map-venue map-venue-pre">Preprint</span
      ><span><strong>Bold</strong>: first author</span></span
    >
    The grouping describes shared questions rather than a chronological sequence.
  </figcaption>
</figure>

<style>
  .research-map {
    margin-top: 24px;
  }
  .map-question {
    padding: 22px 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--paper-raised) 86%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 40px -30px rgba(var(--blueberry-rgb), 0.6);
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    text-align: center;
  }
  .map-kicker {
    display: block;
    margin-bottom: 6px;
    color: var(--strawberry);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .map-branches {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding-top: 34px;
  }
  .map-branch {
    --tone: var(--blueberry);
    --tone-wash: var(--accent-soft);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 22px 22px 20px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--tone);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-raised) 90%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 44px -32px rgba(var(--blueberry-rgb), 0.65);
  }
  .map-branch-strawberry {
    --tone: var(--strawberry);
    --tone-wash: #fbeeed;
  }
  .map-branch-moss {
    --tone: #2f7a56;
    --tone-wash: #e8f3ec;
  }
  .map-branch::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -38px;
    width: 1px;
    height: 34px;
    background: var(--line-strong);
  }
  .map-branch-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .map-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: var(--tone);
    background: var(--tone-wash);
  }
  .map-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map-count {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .map-branch h3 {
    margin-top: 16px;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .map-branch h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .map-branch h3 a:hover {
    color: var(--tone);
  }
  .map-branch p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .map-branch ul {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .map-branch li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
  }
  .map-branch li a:hover .map-work {
    color: var(--tone);
    text-decoration: underline;
  }
  .map-work-first {
    font-weight: 600;
  }
  .map-venue {
    flex-shrink: 0;
    padding: 2px 9px;
    border: 1px solid var(--tone, var(--blueberry));
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }
  .map-venue-peer {
    color: white;
    background: var(--tone, var(--blueberry));
  }
  .map-venue-pre {
    color: var(--tone, var(--blueberry));
    background: transparent;
  }
  .map-empirical {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-top: 24px;
    padding: 16px 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-raised) 90%, transparent);
    backdrop-filter: blur(10px);
  }
  .map-empirical-title {
    flex-shrink: 0;
    color: var(--ink);
    font-weight: 600;
  }
  .map-empirical p {
    color: var(--muted);
    font-size: 15px;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 14px;
    color: var(--muted);
    font-size: 13px;
  }
  .map-legend {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .map-legend .map-venue {
    font-size: 11px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .map-branches {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-top: 16px;
    }
    .map-branch::before {
      display: none;
    }
    .map-question {
      padding: 18px 20px;
      text-align: left;
    }
    .map-empirical {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
