---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<test-lab class:list={['test-lab', { compact }]}>
  <div class="lab-top">
    <span>A small test of confidence</span><span class="lab-language">Python</span>
  </div>
  <div class="lab-code" aria-label="Python function with a deliberate bug">
    <code
      ><span class="code-comment"># Return the largest number</span><br /><span class="code-keyword"
        >{'def '}</span
      >
      <b>largest</b>(numbers):<br />&nbsp;&nbsp;&nbsp;&nbsp;best = <span class="code-number">0</span
      ><br />&nbsp;&nbsp;&nbsp;&nbsp;<span class="code-keyword">for</span> n <span
        class="code-keyword">in</span
      > numbers:<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;best = max(best, n)<br
      />&nbsp;&nbsp;&nbsp;&nbsp;<span class="code-keyword">return</span> best</code
    >
  </div>
  <div class="test-table">
    <div class="test-row test-head">
      <span>Test input</span><span>Expected</span><span>Result</span>
    </div>
    <div class="test-row"><code>[2, 7, 4]</code><code>7</code><span class="pass">Pass</span></div>
    <div class="test-row"><code>[0, 3, 1]</code><code>3</code><span class="pass">Pass</span></div>
    <div class="test-row" data-negative-row hidden>
      <code>[-8, -2, -5]</code><code>-2</code><span class="fail">Fail: 0</span>
    </div>
  </div>
  <div class="lab-actions">
    <button type="button" data-test-button
      >Add a harder test <span aria-hidden="true">+</span></button
    ><span data-test-count>2 / 2 passed</span>
  </div>
  <p class="lab-verdict" data-verdict aria-live="polite">
    All tests pass. Is the function correct?
  </p>
  <noscript
    ><p class="lab-noscript">
      Try [-8, -2, -5]: the function returns 0 instead of -2. Initializing best to 0 fails for
      all-negative inputs. Passing two tests did not establish correctness.
    </p></noscript
  >
</test-lab>

<style>
  .test-lab {
    display: block;
    border: 1px solid #c3d3eb;
    background: #f6f9ff;
    border-radius: 7px;
    overflow: hidden;
    min-width: 0;
  }
  .lab-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    background: #e9f0fc;
    padding: 15px 23px;
    color: #294d86;
    font-size: 14px;
  }
  .lab-language {
    color: #536176;
  }
  .lab-code {
    padding: 22px 25px;
    font-size: 16px;
    line-height: 1.75;
    background-image: radial-gradient(#c4d2e6 0.65px, transparent 0.65px);
    background-size: 12px 12px;
    overflow-x: auto;
  }
  .lab-code code {
    display: block;
    background: #f6f9ff;
    width: fit-content;
    padding-right: 12px;
  }
  .code-keyword {
    color: #2454c6;
  }
  .code-number {
    color: #a54022;
  }
  .code-comment {
    color: #536176;
  }
  .test-table {
    padding-inline: 23px;
  }
  .test-row {
    display: grid;
    grid-template-columns: 1fr 75px 65px;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid #d8e0ea;
    font-size: 14px;
  }
  .test-row code {
    font-size: 13px;
  }
  .test-head {
    font-size: 12px;
    color: #536176;
  }
  .pass {
    color: #236246;
  }
  .fail {
    color: #a43224;
    font-weight: 600;
  }
  .lab-actions {
    padding: 20px 23px 8px;
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }
  button {
    padding: 9px 14px;
    border: 1px solid #2454c6;
    background: #2454c6;
    color: white;
    border-radius: 4px;
    font-size: 14px;
  }
  button:hover {
    background: #153f9e;
  }
  button span {
    margin-left: 13px;
  }
  [data-test-count] {
    color: #536176;
    font-size: 13px;
    white-space: nowrap;
  }
  .lab-verdict,
  .lab-noscript {
    margin: 0 !important;
    padding: 12px 23px 22px;
    font-size: 14px;
    line-height: 1.6;
    color: #435774;
  }
  @media (max-width: 420px) {
    .lab-top,
    .lab-actions {
      padding-inline: 17px;
    }
    .lab-code {
      padding-inline: 17px;
      font-size: 14px;
    }
    .test-table {
      padding-inline: 17px;
    }
    .test-row {
      grid-template-columns: 1fr 65px 55px;
      gap: 6px;
    }
    .lab-actions {
      gap: 10px;
      flex-wrap: wrap;
    }
    .lab-verdict {
      padding-inline: 17px;
    }
  }
</style>

<script>
  class TestLab extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-test-button]')!;
      const row = this.querySelector<HTMLElement>('[data-negative-row]')!;
      const count = this.querySelector('[data-test-count]')!;
      const verdict = this.querySelector('[data-verdict]')!;
      button.addEventListener('click', () => {
        const expanded = row.hidden;
        row.hidden = !expanded;
        button.textContent = expanded ? 'Reset example' : 'Add a harder test +';
        count.textContent = expanded ? '2 / 3 passed' : '2 / 2 passed';
        verdict.textContent = expanded
          ? 'The initial value, 0, is larger than every negative input. A stronger test exposes the bug. Passing tests is evidence, not a proof.'
          : 'All tests pass. Is the function correct?';
      });
    }
  }
  if (!customElements.get('test-lab')) customElements.define('test-lab', TestLab);
</script>
