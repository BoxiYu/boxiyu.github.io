---
import Base from '../layouts/Base.astro';
import CourseShowcase from '../components/CourseShowcase.astro';
---

<Base
  title="Courses"
  description="Interactive lecture notes and videos for eight courses, and the Agentic Software Engineering open course, by Boxi Yu."
>
  <div class="wrapper courses-page">
    <header class="courses-hero">
      <p class="courses-kicker">Courses · interactive lecture notes and videos</p>
      <h1>Interactive notes for every lecture.</h1>
      <p class="courses-lede">
        Companion sites for eight courses, from AI literacy for everyone to building software with
        coding agents. Each lecture walks through its ideas one step at a time, asks you to predict
        before it shows you, and ends with a self-check.
      </p>
      <a class="courses-jump" href="#agentic-se">Agentic SE open course ↓</a>
    </header>

    <section class="courses-notes" id="notes" aria-label="Eight courses">
      <CourseShowcase />
    </section>

    <section class="course-feature" id="agentic-se" aria-labelledby="course-title">
      <div class="course-feature-label">
        <span class="course-mark" aria-hidden="true">AS</span>
        <p class="courses-kicker">Open course · Fall 2026</p>
      </div>
      <div>
        <h2 id="course-title">Agentic Software Engineering</h2>
        <p class="course-summary">
          A twelve-week course on building software with coding agents: agents generate, and
          students verify, decide, and explain. Each week pairs a lecture with a practitioner talk or
          a project studio, and every example shows both generation and verification.
        </p>
        <dl class="course-details">
          <div>
            <dt>For</dt>
            <dd>Students who build software with coding agents</dd>
          </div>
          <div>
            <dt>Topics</dt>
            <dd>Agent internals, context engineering, code review, testing, security, and evaluating agents</dd>
          </div>
          <div>
            <dt>Format</dt>
            <dd>Weekly notes and short films; assignments, open-source contributions, a term project, and two checkpoints without AI</dd>
          </div>
        </dl>
        <a class="courses-link" href="https://boxi-cs.github.io/agentic-se/"
          >Browse the course materials ↗</a
        >
      </div>
    </section>

    <section class="courses-next" aria-labelledby="courses-next-title">
      <p class="courses-kicker">Teaching &amp; supervision</p>
      <h2 id="courses-next-title">Classroom teaching, Ph.D. supervision, and mentoring.</h2>
      <p>Courses I assisted at CUHK–Shenzhen, and where the students I mentored went next.</p>
      <a class="courses-button" href="/teaching/">Teaching &amp; supervision →</a>
    </section>
  </div>
</Base>

<style>
  .courses-hero {
    padding: 66px 0 56px;
    border-bottom: 1px solid var(--line);
  }
  .courses-kicker {
    color: var(--blue);
    font-size: 14px;
    letter-spacing: 0.04em;
    margin-bottom: 15px;
  }
  .courses-hero h1 {
    max-width: 820px;
    color: var(--ink);
    font-size: clamp(2.8rem, 6.4vw, 5.2rem);
    line-height: 0.98;
  }
  .courses-lede {
    max-width: 680px;
    margin-top: 28px;
    color: var(--muted);
    font-size: 20px;
    line-height: 1.55;
  }
  .courses-jump {
    display: inline-block;
    margin-top: 28px;
    font-size: 16px;
  }
  .courses-link {
    font-size: 16px;
  }
  .courses-notes {
    padding: 56px 0 76px;
    border-bottom: 1px solid var(--line);
  }
  .course-feature {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(42px, 9vw, 120px);
    padding: 76px 0;
    border-bottom: 1px solid var(--line);
  }
  .course-mark {
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    margin-bottom: 28px;
    color: var(--blue);
    font-family: var(--serif);
    font-size: 27px;
    border: 1px solid var(--blue);
  }
  .course-feature h2,
  .courses-next h2 {
    color: var(--ink);
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .course-summary {
    max-width: 670px;
    margin: 22px 0 30px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.6;
  }
  .course-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0 0 28px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .course-details dt {
    color: var(--blue);
    font-size: 14px;
  }
  .course-details dd {
    margin-top: 7px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .courses-next {
    max-width: 760px;
    padding: 76px 0 96px;
  }
  .courses-next > p:not(.courses-kicker) {
    margin: 18px 0 28px;
    color: var(--muted);
    font-size: 18px;
  }
  .courses-button {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 8px 18px;
    color: var(--paper-raised);
    background: var(--blue);
    text-decoration: none;
    border: 1px solid var(--blue);
  }
  .courses-button:hover {
    color: var(--paper-raised);
    background: var(--blue-dark);
  }
  @media (max-width: 760px) {
    .courses-hero {
      padding: 54px 0 44px;
    }
    .courses-hero h1 {
      font-size: clamp(2.8rem, 14vw, 4.5rem);
    }
    .courses-lede {
      font-size: 19px;
    }
    .courses-notes,
    .course-feature {
      padding: 54px 0;
    }
    .course-feature {
      grid-template-columns: 1fr;
      gap: 42px;
    }
    .course-details {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
