---
import Base from '../layouts/Base.astro';
import ResearchMap from '../components/ResearchMap.astro';
import ResearchList from '../components/ResearchList.astro';
import CourseShowcase from '../components/CourseShowcase.astro';
import { site } from '../data/site';
import { oneaiOlympiadSchools, oneaiSchoolCount, oneaiSubjects } from '../data/oneai';
import { pacificProducts } from '../data/pacific';
import { equityProjects } from '../data/equity';
import { formatDate, getWriting } from '../lib/writing';
import { news } from '../lib/legacy';

const writing = (await getWriting()).slice(0, 2);
const latest = [
  ...writing.map((entry) => ({ kind: 'writing' as const, date: entry.data.publishedAt, entry })),
  ...news.slice(0, 3).map((item) => ({ kind: 'news' as const, date: item.date, item })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 4);
---

<Base
  description="Boxi Yu studies how to test and evaluate software and AI systems, then turns that evidence into products and teaching."
>
  <div class="home-shell">
    <section class="home-hero wrapper" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="hero-kicker"><span class="hero-dot"></span> Research · products · teaching</p>
        <h1 id="intro-title">Human-centric AI <em>and software.</em></h1>
        <p class="hero-lede">
          I am Boxi Yu, a software engineering researcher at Lero. I study how to test and evaluate
          coding agents and AI systems so that people can decide when to trust them, then turn those
          lessons into tools people can use and courses people can learn from.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/research/"
            >Explore the research <span aria-hidden="true">↗</span></a
          >
          <a class="button button-quiet" href="#courses">Learn from the courses</a>
        </div>
        <p class="hero-elsewhere">
          <a href={site.scholar}>Google Scholar</a><a href={site.github}>GitHub</a><a href={site.x}
            >X</a
          ><a href="/about/#contact">Email</a>
        </p>
      </div>
      <figure class="hero-portrait">
        <div class="hero-portrait-frame">
          <img
            src="/assets/img/prof_pic.jpg"
            width="772"
            height="766"
            alt="Portrait of Boxi Yu"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <strong>Boxi Yu</strong>
          <span>{site.role}</span>
          <span class="hero-portrait-place"
            ><span class="signal-pulse"></span> University of Limerick</span
          >
        </figcaption>
      </figure>
    </section>

    <section class="home-section wrapper" aria-labelledby="research-heading">
      <div class="home-section-head">
        <h2 id="research-heading">Research</h2>
        <a href="/research/">All research <span aria-hidden="true">↗</span></a>
      </div>
      <ResearchMap />
      <h3 class="home-subhead" id="selected-heading">Representative work</h3>
      <ResearchList selected={['swe-abs', 'utboost', 'cxbench', 'lightad']} />
    </section>

    <section class="home-section wrapper courses-section" id="courses" aria-labelledby="courses-heading">
      <div class="home-section-head">
        <div>
          <p class="eyebrow">Teaching · interactive lecture notes</p>
          <h2 id="courses-heading">Five courses, every lecture you can run</h2>
        </div>
        <a href="/teaching/#notes">All teaching <span aria-hidden="true">↗</span></a>
      </div>
      <p class="home-intro">
        For five courses, I build one interactive page per lecture: from AI literacy for everyone,
        through a first Python program, data structures and linear algebra, to building software with
        coding agents. Every program and interactive check has been run, and every output shown is the real one.
      </p>
      <CourseShowcase />
    </section>

    <section class="course-section" aria-labelledby="course-heading">
      <div class="wrapper course-grid">
        <div>
          <p class="eyebrow">Teaching · open course · Fall 2026</p>
          <h2 id="course-heading">Agentic Software Engineering</h2>
          <div class="course-actions">
            <a class="button button-primary" href="/teaching/"
              >Course &amp; teaching <span aria-hidden="true">↗</span></a
            ><a class="button button-quiet" href="https://boxi-cs.github.io/agentic-se/"
              >Open course site</a
            >
          </div>
        </div>
        <div>
          <p class="course-tagline">Agents generate. You verify, decide and explain.</p>
          <p class="course-copy">
            A practical twelve-week course for building with coding agents while keeping
            specifications, tests, review, security, and judgment in the loop.
          </p>
          <p class="course-copy">
            I have also mentored ten students. All ten co-authored peer-reviewed papers with me at
            ICSE, ESEC/FSE, or ISSTA, and eight are now Ph.D. students.{' '}
            <a href="/teaching/#mentoring">See where they went</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="home-section wrapper" aria-labelledby="applied-heading">
      <div class="home-section-head">
        <div>
          <p class="eyebrow">Co-founder</p>
          <h2 id="applied-heading">Products</h2>
        </div>
        <a href="/products/">All products <span aria-hidden="true">↗</span></a>
      </div>
      <p class="home-intro">
        Alongside my research I co-founded OneAI and Pacific Studio, where we build AI products that
        keep people in the decision seat.
      </p>
      <article class="applied-feature">
        <div class="feature-copy">
          <div class="feature-top">
            <span class="status-dot"></span><span>Co-founder · In use · AI education</span>
          </div>
          <p class="product-mark">ONE<span>AI</span></p>
          <h3>Assessment Studio</h3>
          <p>
            Turn a learning objective into a question set, rubric, and student-level feedback loop.
            Teachers stay in the decision seat; AI handles the first pass.
          </p>
          <p class="feature-use">
            In use at {oneaiSchoolCount} schools in Guangzhou and Shenzhen, including olympiad training
            in {oneaiSubjects} at{' '}
            {
              oneaiOlympiadSchools.map((school, index) => (
                <>
                  {index > 0 && ' and '}
                  <a href={school.href}>{school.name}</a>
                </>
              ))
            }
            .
          </p>
          <div class="tag-row"><span>Generate</span><span>Review</span><span>Explain</span></div>
          <a class="feature-link" href="/products/#oneai"
            >See the workflow <span aria-hidden="true">↗</span></a
          >
        </div>
        <figure class="demo-video">
          <video
            controls
            preload="metadata"
            poster="/assets/img/oneai-math-education-poster.jpg"
            playsinline
            aria-describedby="demo-caption"
          >
            <source src="/assets/video/oneai-math-education.mp4" type="video/mp4" />
            Your browser does not support embedded video.
          </video>
          <figcaption id="demo-caption">
            Demo · student guidance, assessment generation, teacher review · 1:33
          </figcaption>
        </figure>
      </article>
    </section>

    <section class="home-section wrapper pacific-section" aria-labelledby="pacific-heading">
      <div class="home-section-head">
        <div>
          <p class="eyebrow">Co-founder · build, prove, understand</p>
          <h2 id="pacific-heading">Pacific Studio</h2>
        </div>
        <a href="https://pacificstudio.ai/">See the studio <span aria-hidden="true">↗</span></a>
      </div>
      <p class="home-intro">
        Three products from Pacific Studio, which I co-founded, show how AI can support the software
        lifecycle: ship the work, check the proof, and read the ideas that shape it.
      </p>
      <div class="pacific-grid">
        {
          pacificProducts.map((product, index) => (
            <article class="pacific-card">
              <div class="pacific-card-top">
                <span class="pacific-card-index">0{index + 1}</span>
                <span class="pacific-card-status">{product.status}</span>
              </div>
              <p class="pacific-card-verb">{product.verb}</p>
              <h3>{product.name}</h3>
              <p class="pacific-card-copy">{product.description}</p>
              <div class="pacific-card-footer">
                <span>{product.detail}</span>
                <a href={product.href} target="_blank" rel="noreferrer">
                  {product.cta} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="home-section wrapper equity-section" aria-labelledby="equity-heading">
      <div class="home-section-head">
        <div>
          <p class="eyebrow">AI education · free and open</p>
          <h2 id="equity-heading">Education equity</h2>
        </div>
        <a href="https://boxi-math.github.io/en/"
          >Visit Boxi Math <span aria-hidden="true">↗</span></a
        >
      </div>
      <p class="home-intro">
        A good tutor is still a luxury. I want every child to understand why maths works, whatever
        their family can pay and whichever language they speak. So I make teaching, starting with
        maths, that is free to watch and free to reuse, with AI tools I release as open source.
      </p>
      <div class="pacific-grid equity-grid">
        {
          equityProjects.map((project, index) => (
            <article class="pacific-card">
              <div class="pacific-card-top">
                <span class="pacific-card-index">0{index + 1}</span>
                <span class="pacific-card-status">{project.status}</span>
              </div>
              <p class="pacific-card-verb">{project.verb}</p>
              <h3>{project.name}</h3>
              <p class="pacific-card-copy">{project.description}</p>
              <div class="pacific-card-footer">
                <span>{project.detail}</span>
                <a href={project.href} target="_blank" rel="noreferrer">
                  {project.cta} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <aside class="equity-invite" aria-labelledby="equity-invite-heading">
        <div>
          <p class="eyebrow">Open invitation</p>
          <h3 id="equity-invite-heading">Build it with us, in your language</h3>
        </div>
        <div>
          <p>
            Boxi Math and Boxi Learn are in English and Chinese today, but children learn best in
            the language they think in. I would like to build this with scholars and teachers who
            speak other languages: adapting lessons and videos to your language and curriculum,
            checking that the subject reads naturally to your students, and making new lessons with
            the open animind tools. Everything stays free: Boxi Math under CC BY 4.0, Boxi Learn under CC BY-SA 4.0.
          </p>
          <div class="equity-invite-links">
            <a href={`mailto:${site.email}?subject=Education%20equity`}>Write to me</a>
            <a href="https://github.com/boxi-learn" target="_blank" rel="noreferrer"
              >Boxi Learn on GitHub <span aria-hidden="true">↗</span></a
            >
            <a href="https://github.com/boxi-math" target="_blank" rel="noreferrer"
              >Boxi Math on GitHub <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
      </aside>
    </section>

    <section class="home-section wrapper home-latest" aria-labelledby="latest-heading">
      <div class="home-section-head">
        <h2 id="latest-heading">News &amp; writing</h2>
        <p class="home-latest-links">
          <a href="/news/">All news <span aria-hidden="true">↗</span></a>
          <a href="/writing/">Blog <span aria-hidden="true">↗</span></a>
        </p>
      </div>
      <ul class="news-list">
        {
          latest.map((row) => (
            <li>
              <time datetime={row.date.toISOString()}>{formatDate(row.date)}</time>
              {row.kind === 'writing' ? (
                <div>
                  <p>
                    <span class="latest-tag">Blog</span>
                    <a href={'/writing/' + row.entry.id + '/'}>{row.entry.data.title}</a>
                  </p>
                  <p class="latest-description">{row.entry.data.description}</p>
                </div>
              ) : (
                <div set:html={row.item.html} />
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .home-shell {
    overflow: hidden;
  }
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 80px;
    align-items: center;
    padding-block: 84px 88px;
  }
  .hero-kicker,
  .eyebrow {
    margin-bottom: 20px;
    color: var(--strawberry);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-kicker {
    display: flex;
    gap: 11px;
    align-items: center;
    color: var(--muted);
  }
  .hero-dot,
  .status-dot,
  .signal-pulse {
    display: inline-block;
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--strawberry);
    box-shadow: 0 0 0 4px rgba(var(--strawberry-rgb), 0.14);
  }
  .hero-copy h1 {
    max-width: 700px;
    color: var(--blueberry);
    font-size: clamp(3.2rem, 6.6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .hero-copy h1 em {
    display: block;
    color: var(--strawberry);
  }
  .hero-lede {
    max-width: 600px;
    margin-top: 28px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.65;
  }
  .hero-actions,
  .course-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .hero-elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 30px;
    font-size: 15px;
  }
  .hero-elsewhere a {
    color: var(--muted);
    text-decoration-color: var(--line-strong);
  }
  .hero-elsewhere a:hover {
    color: var(--blue);
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 9px 17px;
    border: 1px solid var(--blue);
    border-radius: 999px;
    font-size: 15px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }
  .button:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }
  .button-primary {
    color: white;
    background: var(--strawberry);
    border-color: var(--strawberry);
  }
  .button-primary:hover {
    color: white;
    background: var(--strawberry-dark);
    border-color: var(--strawberry-dark);
  }
  .button-quiet {
    color: var(--ink);
    background: transparent;
  }
  .button-quiet:hover {
    color: var(--blue);
    background: var(--wash);
  }
  .hero-portrait-frame {
    background: white;
  }
  .hero-portrait img {
    width: 100%;
    aspect-ratio: 4 / 4.5;
    object-fit: cover;
    object-position: center 20%;
  }
  .hero-portrait figcaption {
    display: grid;
    gap: 2px;
    margin-top: 20px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .hero-portrait figcaption strong {
    color: var(--ink);
    font-size: 17px;
    font-weight: 600;
  }
  .hero-portrait-place {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 8px;
  }
  .home-section {
    padding-block: 80px;
  }
  .courses-section {
    padding-top: 64px;
  }
  .home-hero + .home-section,
  .home-section + .home-section {
    border-top: 1px solid var(--line);
  }
  .home-section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }
  .home-section-head .eyebrow {
    margin-bottom: 12px;
  }
  .home-section-head h2 {
    max-width: 650px;
    font-size: clamp(2rem, 3.4vw, 2.9rem);
  }
  .home-section-head > a {
    flex-shrink: 0;
    font-size: 15px;
  }
  .applied-feature {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: 48px;
    align-items: center;
    padding: 40px;
    color: var(--paper-raised);
    background: linear-gradient(135deg, var(--blueberry), var(--blue-dark) 80%);
  }
  .feature-top {
    display: flex;
    gap: 11px;
    align-items: center;
    margin-bottom: 34px;
    color: var(--buttercream);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .feature-top .status-dot {
    background: var(--accent-light);
    box-shadow: 0 0 0 4px rgba(var(--buttercream-rgb), 0.2);
  }
  .product-mark {
    color: var(--accent-light);
    font-family: monospace;
    font-size: 14px;
    letter-spacing: 0.12em;
  }
  .product-mark span {
    color: white;
  }
  .feature-copy h3 {
    margin-top: 8px;
    color: white;
    font-family: var(--serif);
    font-size: clamp(2.1rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .feature-copy > p:not(.product-mark) {
    margin-top: 18px;
    color: var(--buttercream);
    font-size: 16px;
  }
  .feature-copy > p.feature-use {
    padding-top: 16px;
    border-top: 1px solid rgba(var(--buttercream-rgb), 0.3);
    color: white;
    font-size: 15px;
  }
  .feature-use a {
    color: white;
    text-decoration-color: rgba(var(--buttercream-rgb), 0.6);
  }
  .feature-use a:hover {
    color: var(--accent-light);
  }
  .tag-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  .tag-row span {
    padding: 4px 9px;
    border: 1px solid rgba(var(--buttercream-rgb), 0.5);
    border-radius: 999px;
    color: var(--accent-light);
    font-size: 12px;
  }
  .feature-link {
    display: inline-flex;
    gap: 12px;
    margin-top: 28px;
    color: white;
    font-size: 15px;
    text-decoration: none;
  }
  .feature-link:hover {
    color: var(--accent-light);
  }
  .demo-video {
    margin: 0;
  }
  .demo-video video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: var(--blue-dark);
  }
  .demo-video figcaption {
    margin-top: 12px;
    color: var(--accent-light);
    font-size: 13px;
  }
  .home-intro {
    max-width: 660px;
    margin: -12px 0 34px;
    color: var(--muted);
    font-size: 17px;
  }
  .pacific-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .pacific-card {
    display: flex;
    min-height: 360px;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    background: linear-gradient(155deg, var(--wash) 0%, var(--paper-raised) 58%);
  }
  .pacific-card:nth-child(2) {
    background: linear-gradient(155deg, var(--accent-soft) 0%, var(--paper-raised) 58%);
  }
  .pacific-card:nth-child(3) {
    background: linear-gradient(155deg, var(--buttercream-soft) 0%, var(--paper-raised) 58%);
  }
  .equity-grid .pacific-card {
    min-height: 320px;
  }
  .pacific-card-top,
  .pacific-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .pacific-card-index,
  .pacific-card-status,
  .pacific-card-verb,
  .pacific-card-footer {
    font-size: 13px;
  }
  .pacific-card-index {
    color: var(--muted);
    font-family: monospace;
  }
  .pacific-card-status {
    padding: 3px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--blue-dark);
    line-height: 1.2;
  }
  .pacific-card-verb {
    margin-top: 42px;
    color: var(--blue);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pacific-card h3 {
    margin-top: 5px;
    color: var(--blueberry);
    font-family: var(--serif);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 400;
  }
  .pacific-card-copy {
    margin-top: 14px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }
  .pacific-card-footer {
    align-items: end;
    margin-top: auto;
    padding-top: 28px;
    color: var(--muted);
    font-size: 12px;
  }
  .pacific-card-footer a {
    flex-shrink: 0;
    color: var(--blue);
    font-size: 14px;
    text-decoration: none;
  }
  .pacific-card-footer a:hover {
    color: var(--blue-dark);
  }
  .equity-invite {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 16px 40px;
    margin-top: 16px;
    padding: 28px 24px;
    border: 1px dashed var(--line-strong);
  }
  .equity-invite h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.2;
  }
  .equity-invite p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
  }
  .equity-invite-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 18px;
    font-size: 15px;
  }
  .equity-invite-links a {
    color: var(--blue);
  }
  .equity-invite-links a:hover {
    color: var(--blue-dark);
  }
  .home-subhead {
    margin: 56px 0 24px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .course-section {
    background: linear-gradient(120deg, var(--accent-wash), var(--buttercream-soft));
    border-block: 1px solid var(--line);
  }
  .course-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 64px;
    align-items: center;
    padding-block: 78px;
  }
  .course-grid h2 {
    max-width: 700px;
    font-size: clamp(2.5rem, 4.7vw, 4rem);
    color: var(--blueberry);
  }
  .course-tagline {
    color: var(--strawberry);
    font-family: var(--serif);
    font-size: 1.5rem;
    font-style: italic;
  }
  .course-copy {
    max-width: 570px;
    margin-top: 16px;
    color: var(--muted);
  }
  .course-grid .button-primary {
    background: var(--blue-dark);
