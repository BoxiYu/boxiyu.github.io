---
import Base from '../../layouts/Base.astro';
import { excerpt, news } from '../../lib/legacy';
import { formatDate } from '../../lib/writing';
export function getStaticPaths() {
  return news.map((item) => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
const title = `Update, ${formatDate(item.date)}`;
---

<Base title={title} description={excerpt(item.summary)}
  ><div class="wrapper">
    <header class="page-header">
      <a class="back-link" href="/news/">All updates</a><h1>Update</h1><p>
        {formatDate(item.date)}
      </p>
    </header><div class="page-body prose" set:html={item.html} />
  </div></Base
>
