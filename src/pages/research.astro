---
import Base from '../layouts/Base.astro';
import RetromorphicDiagram from '../components/RetromorphicDiagram.astro';
import { paperVideos, projects, site } from '../data/site';
const themes = [
  {
    id: 'coding-agents',
    title: 'Evaluating coding agents',
    description:
      "A patch can pass a benchmark's tests and still be wrong. I investigate how test adequacy affects measured agent performance, and how to make the evaluation harder to satisfy with incorrect behavior.",
    projects: ['swe-abs', 'utboost'],
  },
  {
    id: 'test-oracles',
    title: 'Constructing test oracles',
    description:
      'For many programs, specifying the right answer is harder than running the program. My work explores relations between executions and between programs as a way to detect failures without enumerating correct outputs.',
    projects: ['rt4chart', 'retromorphic-testing'],
  },
  {
    id: 'ai-systems',
    title: 'Testing AI systems',
    description:
      'AI systems produce outputs that can be difficult to assess automatically. Controlled transformations and consistency relations provide practical ways to uncover mistakes in language and vision systems, and process-level checks show when an agent reaches the right outcome the wrong way.',
    projects: ['cxbench', 'rome', 'tin', 'metaic'],
  },
  {
    id: 'aiops',
    title: 'Empirical evaluation for AIOps',
    description:
      'Reliable operational tools need evidence about accuracy, efficiency, and the impact of data preprocessing. I study these choices in log-based anomaly detection.',
    projects: ['lightad'],
  },
];
---

<Base
  title="Research"
  description="Research by Boxi Yu: rigorous evaluation of coding agents, test oracle construction, metamorphic testing of AI, and log-based anomaly detection."
>
  <div class="wrapper">
    <header class="page-header">
      <h1>Research</h1><p>
        I develop testing and evaluation methods that uncover failures in software and AI, and
        examine what our tests actually establish.
      </p><div class="resource-links">
        <a href="/publications/">All publications</a><a href={site.scholar}>Google Scholar</a><a
          href="/papers.bib">BibTeX</a
        >
      </div>
    </header>
    <nav class="research-jump" aria-label="Research topics">
      {themes.map((theme) => <a href={`#${theme.id}`}>{theme.title}</a>)}
    </nav>
    {
      themes.map((theme) => (
        <section class="section research-theme" aria-labelledby={theme.id}>
          <header class="theme-heading">
            <>
              <h2 id={theme.id}>{theme.title}</h2>
              <p>{theme.description}</p>
            </>
          </header>
          <div class="theme-papers">
            {theme.projects.map((id) => {
              const project = projects.find((project) => project.id === id)!;
              return (
                <article class="research-detail" id={project.id}>
                  <p class="paper-context">
                    {project.name} / {project.venue} {project.year}
                    {project.venue === 'arXiv' ? ' (preprint)' : ''}
                  </p>
                  <h3>{project.question}</h3>
                  <dl>
                    <dt>Approach</dt>
                    <dd>{project.method}</dd>
                    <dt>Findings &amp; contribution</dt>
                    <dd>{project.finding}</dd>
                  </dl>
                  {id === 'retromorphic-testing' && <RetromorphicDiagram />}
                  {paperVideos[id] && (
                    <figure class="research-video">
                      <video
                        controls
                        preload="none"
                        playsinline
                        poster={`/assets/img/paper-${id}-poster.jpg`}
                        width="1920"
                        height="1080"
                        aria-describedby={`${id}-video-caption`}
                      >
                        <source src={`/assets/video/paper-${id}.mp4`} type="video/mp4" />
                        Your browser does not support embedded video.
                      </video>
                      <figcaption id={`${id}-video-caption`}>
                        {paperVideos[id].caption} · {paperVideos[id].duration}
                      </figcaption>
                    </figure>
                  )}
                  <div class="resource-links">
                    {project.links.map((link) => (
                      <a href={link.href}>{link.label}</a>
                    ))}
                    <a href={`/publications/#${project.paper}`}>Full citation</a>
                  </div>
                </article>
              );
            })}
            {theme.id === 'coding-agents' && (
              <aside class="related-research">
                <h3>Specification alignment &amp; training data</h3>
                <p>
                  <a href="/publications/#xu2026bespec">BeSpec (ICSE 2027)</a> builds explicit
                  behavioral specifications and uses execution on probe inputs to refine the
                  specification or reject candidate programs.{' '}
                  <a href="/publications/#zheng2026adr">Combinatorial Synthesis</a>, a 2026
                  preprint, introduces atomic decomposition and recombination to generate verifiable
                  code tasks for reinforcement learning.
                </p>
              </aside>
            )}
            {theme.id === 'coding-agents' && (
              <aside class="related-research">
                <h3>Benchmark design beyond individual test suites</h3>
                <p>
                  A position paper I co-authored,{' '}
                  <a href="/publications/#cao2025">
                    Code Benchmarks Should Prioritize Rigor, Reliability, and Reproducibility
                  </a>
                  , surveys 672 code benchmarks and introduces HOW2BENCH, a guideline with 55
                  checklist items. It connects individual evaluation failures to broader questions
                  about benchmark construction and reproducibility.
                </p>
                <p class="source-note">
                  Survey scope follows <a href="https://arxiv.org/abs/2501.10711v5">arXiv v5</a>;
                  earlier versions used a smaller corpus and a different title.
                </p>
              </aside>
            )}
            {theme.id === 'coding-agents' && (
              <aside class="related-research" id="frontiercs2">
                <h3>From coding tasks to research tasks</h3>
                <p>
                  <a href="/publications/#mang2026frontiercs2">FrontierCS 2</a>, a 2026 preprint I
                  co-authored, asks whether agents can do computer science R&amp;D. Each of its 48
                  tasks removes a paper's key contribution from the code released with it; an agent
                  passes only if its implementation beats the original on every metric on the hidden
                  workloads. The best of 12 agents passes 58% of its runs, and 16 tasks are not passed by any run.
                </p>
                <figure class="research-video">
                  <video
                    controls
                    preload="none"
                    playsinline
                    poster="/assets/img/frontiercs2-poster.jpg"
                    width="1920"
                    height="1080"
                    aria-describedby="frontiercs2-caption"
                  >
                    <source src="/assets/video/frontiercs2.mp4" type="video/mp4" />
                    Your browser does not support embedded video.
                  </video>
                  <figcaption id="frontiercs2-caption">
                    FrontierCS 2 in one minute: the task design, the leaderboard, and two case
                    studies · 1:00
                  </figcaption>
                </figure>
                <div class="resource-links">
                  <a href="https://frontier-cs.org/">Project page</a>
                  <a href="https://github.com/FrontierCS/FrontierCS-2">Code</a>
                </div>
              </aside>
            )}
            {theme.id === 'ai-systems' && (
              <aside class="related-research">
                <h3>Model safety</h3>
                <p>
                  <a href="/publications/#li2026trace">TRACE</a> learns a reusable safety patch
                  across simulated harmful fine-tuning trajectories to recover alignment while
                  preserving task utility. It is a 2026 preprint.
                </p>
              </aside>
            )}
            {theme.id === 'aiops' && (
              <aside class="related-research" id="openrca2">
                <h3>Causal diagnosis for LLM agents</h3>
                <p>
                  <a href="/publications/#fang2026openrca">OpenRCA 2.0</a>, a 2026 preprint I
                  co-authored, labels the causal propagation path from each injected fault to the
                  observed symptom, not only the root cause. Across its 500 instances and 11
                  frontier LLMs, agents name at least one correct root-cause service in 76.0% of
                  cases but ground it in a verified propagation path in only 61.5%.
                </p>
                <figure class="research-video">
                  <video
                    controls
                    preload="none"
                    playsinline
                    poster="/assets/img/paper-openrca-poster.jpg"
                    width="1920"
                    height="1080"
                    aria-describedby="openrca-video-caption"
                  >
                    <source src="/assets/video/paper-openrca.mp4" type="video/mp4" />
                    Your browser does not support embedded video.
                  </video>
                  <figcaption id="openrca-video-caption">
                    {paperVideos.openrca.caption} · {paperVideos.openrca.duration}
                  </figcaption>
                </figure>
                <div class="resource-links">
                  <a href="https://arxiv.org/abs/2606.27154">Paper</a>
                  <a href="/publications/#fang2026openrca">Full citation</a>
                </div>
              </aside>
            )}
            {theme.id === 'aiops' && (
              <aside class="related-research">
                <h3>Contaminated time series</h3>
                <p>
                  <a href="/publications/#zhang2025cleanet">CLEANet</a>, a preprint, combines
                  contamination-resilient training with a lightweight model for multivariate
                  time-series anomaly detection.
                </p>
              </aside>
            )}
          </div>
        </section>
      ))
    }
    <section class="section" aria-labelledby="further-work">
      <div class="section-heading">
        <h2 id="further-work">Multimodal AI &amp; visual computing</h2><a href="/publications/"
          >All publications</a
        >
      </div>
      <div class="prose">
        <p>
          <a href="/publications/#cao2026omnifocus">OmniFocus</a> (2026 preprint) studies query-guided
          audio-visual token compression, estimating importance independently for each modality while
          preserving their alignment. Earlier work on <a href="/publications/#yu2021maskgan"
            >mask-guided GANs</a
          > (Neurocomputing 2021) uses text-body, outline, and shadow masks to guide scene text editing
          while preserving style and background.
        </p>
      </div>
    </section>
  </div>
</Base>
