---
import Base from '../../layouts/Base.astro';
import { talks } from '../../lib/legacy';
import { formatDate } from '../../lib/writing';
export function getStaticPaths() {
  return talks.map((talk) => ({ params: { id: talk.id }, props: { talk } }));
}
const { talk } = Astro.props;
---

<Base title="AI Insight Talk: Code Bench"
  ><div class="wrapper">
    <header class="page-header">
      <a class="back-link" href="/talks/">All talks</a><h1>AI Insight Talk:<br />Code Bench</h1><p>
        {formatDate(talk.date)} / {talk.place}
      </p>
    </header><div class="page-body prose">
      <div set:html={talk.html} /><p>
        <a href="/publications/#yu2025utboost">Related publication: UTBoost</a>
      </p>
    </div>
  </div></Base
>
