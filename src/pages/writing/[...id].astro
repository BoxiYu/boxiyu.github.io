---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWriting, formatDate } from '../../lib/writing';
export async function getStaticPaths() {
  const entries = await getWriting();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const series = entry.data.series
  ? entries
      .filter((item) => item.data.series === entry.data.series)
      .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  : [];
const related = entries
  .filter(
    (item) =>
      item.id !== entry.id && item.data.topics.some((topic) => entry.data.topics.includes(topic)),
  )
  .slice(0, 2);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  language={entry.data.language}
  noindex={entry.data.draft}
  article
>
  <Fragment slot="head"
    ><meta property="article:published_time" content={entry.data.publishedAt.toISOString()} />{
      entry.data.updatedAt && (
        <meta property="article:modified_time" content={entry.data.updatedAt.toISOString()} />
      )
    }</Fragment
  >
  <div class="wrapper">
    <header class="page-header">
      <a class="back-link" href="/writing/">All writing</a><div class="article-meta">
        <span>{entry.data.topics.join(' / ')}</span>{
          !entry.data.draft && (
            <time datetime={entry.data.publishedAt.toISOString()}>
              {formatDate(entry.data.publishedAt)}
            </time>
          )
        }
      </div><h1 style="font-size: clamp(2.5rem, 5vw, 4.1rem)">{entry.data.title}</h1><p>
        {entry.data.description}
      </p><div class="article-meta mt">
        <span>Boxi Yu</span><span>For {entry.data.audience}</span>{
          entry.data.updatedAt && <span>Updated {formatDate(entry.data.updatedAt)}</span>
        }
      </div>
    </header>
    {
      entry.data.draft && (
        <div class="notice">
          <strong>Editorial draft.</strong> Prepared for review. This article is visible only in
          local draft preview and is not included in the published site or RSS feed.
        </div>
      )
    }
    <div class="article-layout">
      <article class="prose">
        <Content />
        {
          related.length > 0 && (
            <nav class="article-bottom" aria-label="Related reading">
              <h3>Keep exploring</h3>
              {related.map((item) => (
                <p>
                  <a href={`/writing/${item.id}/`}>{item.data.title}</a>
                </p>
              ))}
            </nav>
          )
        }
      </article><aside aria-label="Article navigation">
        <strong>In this article</strong>{
          headings.filter((h) => h.depth === 2).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)
        }{
          series.length > 0 && (
            <div class="article-bottom">
              <strong>{entry.data.series}</strong>
              {series.map((item) => (
                <a
                  href={`/writing/${item.id}/`}
                  aria-current={item.id === entry.id ? 'page' : undefined}
                >
                  {item.data.order}. {item.data.title}
                </a>
              ))}
            </div>
          )
        }
      </aside>
    </div>
  </div>
</Base>
